{
  "$ref": "#/definitions/Scenario",
  "definitions": {
    "Scenario": {
      "type": "object",
      "properties": {
        "scenarioId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "sourceFlowIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "operationId": {
                "type": "string"
              },
              "intent": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            },
            "required": [
              "operationId",
              "intent"
            ],
            "additionalProperties": false
          }
        },
        "preconditions": {
          "type": "string"
        },
        "dataRequirements": {
          "type": "string"
        },
        "testDecision": {
          "type": "object",
          "properties": {
            "inScope": {
              "type": "boolean"
            },
            "strategy": {
              "type": "string",
              "enum": [
                "api_functional",
                "api_negative",
                "authz",
                "contract_only",
                "skip"
              ]
            },
            "rationale": {
              "type": "string"
            },
            "riskLevel": {
              "type": "string",
              "enum": [
                "critical",
                "high",
                "medium",
                "low"
              ]
            },
            "environments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "inScope",
            "strategy",
            "rationale",
            "riskLevel",
            "environments"
          ],
          "additionalProperties": false
        },
        "reviewState": {
          "type": "string",
          "enum": [
            "unreviewed",
            "in_review",
            "approved",
            "deprecated",
            "ignored"
          ]
        },
        "updatedBy": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer"
        }
      },
      "required": [
        "scenarioId",
        "name",
        "description",
        "sourceFlowIds",
        "steps",
        "testDecision",
        "reviewState",
        "updatedBy",
        "updatedAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
