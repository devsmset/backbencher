{
  "$ref": "#/definitions/RecordingMeta",
  "definitions": {
    "RecordingMeta": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 2
        },
        "sessionId": {
          "type": "string"
        },
        "sessionName": {
          "type": "string"
        },
        "startUrl": {
          "type": "string",
          "format": "uri"
        },
        "startedAt": {
          "type": "integer"
        },
        "endedAt": {
          "type": "integer"
        },
        "userAgent": {
          "type": "string"
        },
        "operator": {
          "type": "string"
        },
        "authProfile": {
          "type": "string"
        },
        "appVersion": {
          "type": "string"
        },
        "recorderVersion": {
          "type": "string"
        },
        "migratedFromV1": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "sessionId",
        "startUrl",
        "startedAt",
        "userAgent",
        "recorderVersion"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
