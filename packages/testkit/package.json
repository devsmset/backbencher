{
  "name": "@backbencher/testkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@backbencher/schemas": "workspace:*",
    "@backbencher/shared": "workspace:*",
    "@backbencher/store": "workspace:*",
    "ajv": "^8.17.1",
    "js-yaml": "^4.1.0",
    "jsonpath-plus": "^10.2.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9"
  }
}
