# Portal API auth (internal shared analyst token)
PORTAL_TOKEN=changeme

# Anthropic (QA Agent) — server-side only, never bundled into a knowledge pack
ANTHROPIC_API_KEY=

# Log level for pino
BB_LOG_LEVEL=info

# Test runtime auth profiles (resolved by testkit at run time; NEVER in the pack)
# Pattern: BB_AUTH_<PROFILE>_BEARER or BB_AUTH_<PROFILE>_COOKIE
BB_AUTH_ADMIN_BEARER=
BB_AUTH_VIEWER_BEARER=
