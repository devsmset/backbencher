{
  // Backbencher configuration (architecture §3.2). Loaded by @backbencher/shared.
  "recorder": {
    "defaultUrl": null, // must be passed via --url when null
    "tlsPermissive": false, // opt-in; sets ignoreHTTPSErrors + cert flags
    "apiFilter": {
      "hostAllowlist": ["*.otxlab.net"], // empty = all hosts
      "pathAllowPatterns": ["/api/", "/idm-service/", "/bo/"],
      "resourceTypes": ["xhr", "fetch"],
      "dropContentTypes": ["image/", "font/", "text/css", "text/javascript"],
      "dropPathPatterns": ["/analytics", "/telemetry", "/sockjs", "/assets/", "\\.js$", "\\.css$"],
      "dropMethods": ["OPTIONS"]
    },
    "inputDebounceMs": 1000,
    "blockServiceWorkers": true
  },
  // Deprecated: superseded by "llm" below. Still honoured when "llm.models" is empty.
  "agent": {
    "provider": "anthropic", // "anthropic" (ANTHROPIC_API_KEY) | "vertex" (Anthropic on GCP Vertex AI)
    // "model": "claude-3-5-sonnet-latest",
    "vertex": {
      // "projectId": "my-gcp-project",
      // "region": "us-east5",
      // "credentialsFile": "./gcp-service-account.json" // path to a GCP service-account JSON
    }
  },
  // Named models, then per-task routing. Assign every task the same model if you only have one.
  // Providers: "anthropic" | "anthropic-vertex" | "google" (AI Studio key) | "google-vertex"
  // (Gemini on Vertex AI, OAuth) | "openai-compatible" (Ollama, vLLM, LM Studio, LiteLLM, OpenAI).
  //
  // google-vertex auth: `gcloud auth application-default login`, or set credentialsFile /
  // GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON. Set GOOGLE_CLOUD_PROJECT or projectId.
  "llm": {
    "models": {
      "gemini": {
        "provider": "google-vertex",
        "model": "gemini-2.5-pro",
        // "projectId": "my-gcp-project",   // or GOOGLE_CLOUD_PROJECT
        "region": "us-central1"
      },
      "gemini-flash": {
        "provider": "google-vertex",
        "model": "gemini-2.5-flash",
        "region": "us-central1"
      },
      "vectors": {
        "provider": "google-vertex",
        "model": "text-embedding-005",
        "region": "us-central1",
        "taskType": "RETRIEVAL_DOCUMENT"
      }
    },
    "tasks": {
      "default": "gemini",
      "compose": "gemini", // needs reliable constrained JSON
      "generateSpec": "gemini",
      "suggestAnnotation": "gemini-flash", // bulk job over the whole catalog
      "stepIntents": "gemini-flash",
      "embed": "vectors"
    },
    "timeoutMs": 120000,
    "maxRetries": 3
  },
  "environments": [
    { "name": "staging", "baseUrl": "https://te-smax-stg-m.otxlab.net", "destructive": true },
    { "name": "preprod", "baseUrl": "https://te-smax-preprod-m.otxlab.net", "destructive": false }
  ]
}
